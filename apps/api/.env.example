NODE_ENV=development
PORT=8080
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=proctor_scheduler

# Set to instance connection name when running on Cloud Run, e.g.
# CLOUD_SQL_INSTANCE=my-project:us-central1:proctor-pg
# CLOUD_SQL_INSTANCE=

JWT_SECRET=dev-only-secret-change-me-please-1234
JWT_TTL_SECONDS=28800
BCRYPT_COST=12

CORS_ORIGIN=http://localhost:5173

EMAIL_FROM=no-reply@proctor-scheduler.local
# SENDGRID_API_KEY=

# GCP_PROJECT_ID=
USE_SECRET_MANAGER=false
