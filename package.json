{
  "name": "proctor-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "docs:api": "typedoc --options typedoc.json",
    "dev:api": "npm --workspace @app/api run dev",
    "dev:web": "npm --workspace @app/web run dev",
    "dev:demo": "node scripts/dev-demo.mjs",
    "seed:demo": "npm --workspace @app/api run seed:demo",
    "seed:mocker": "npm --workspace @app/api run seed:mocker",
    "setup:gcp": "npm --workspace @app/api run setup:gcp",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typedoc": "^0.28.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
